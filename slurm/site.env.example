# Site-specific settings for slurm/launch.sh.
# Copy to slurm/site.env (git-ignored) and edit. launch.sh sources it and exports everything,
# so these also reach the job. Keep the ${VAR:-default} form: a variable you set on the
# command line (OUT_DIR=... bash slurm/launch.sh) then still wins over this file.

# --- SLURM (read natively by sbatch) ---
SBATCH_ACCOUNT="${SBATCH_ACCOUNT:-my_account}"
SBATCH_PARTITION="${SBATCH_PARTITION:-gpu}"
# SBATCH_CONSTRAINT="${SBATCH_CONSTRAINT:-}"   # e.g. a node feature that has internet access
GPU_TYPE="${GPU_TYPE:-A100}"                   # used as --gpus-per-node=<GPU_TYPE>:<NGPU>

# --- data (see README, "Data") ---
RVIT_TRAIN_DIR="${RVIT_TRAIN_DIR:-/path/to/imagenet-1k/data}"   # train-*.parquet shards
RVIT_VAL_DIR="${RVIT_VAL_DIR:-/path/to/imagenet-1k/val}"        # ImageFolder, one dir per synset

# --- outputs / environment ---
OUT_DIR="${OUT_DIR:-$HOME/runs/recurrent-vit}"  # one sub-directory per run
PY="${PY:-$HOME/venvs/recurrent-vit/bin/python}"
# RVIT_PROXY="${RVIT_PROXY:-http://proxy.example.org:3128}"    # if compute nodes need a proxy
# WANDB_ENTITY="${WANDB_ENTITY:-my_team}"                       # read by wandb itself
